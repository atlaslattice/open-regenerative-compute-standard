# Prescribed trace-ion collision benchmark; no fields or confinement.
max_step = 100
warpx.const_dt = 0.001
warpx.do_electrostatic = labframe
warpx.verbose = 0
warpx.random_seed = 119
amr.n_cell = 8 8 8
amr.max_level = 0
geometry.dims = 3
geometry.prob_lo = -1 -1 -1
geometry.prob_hi = 1 1 1
boundary.field_lo = periodic periodic periodic
boundary.field_hi = periodic periodic periodic
algo.particle_shape = 1
my_constants.mt = 3.0160492779*m_u-m_e
my_constants.md = 2.01410177812*m_u-m_e
my_constants.K = 1.e6*q_e
my_constants.u = sqrt(2*K/(mt*clight*clight)+(K/(mt*clight*clight))^2)
particles.species_names = T_e T_i T_both T_control
T_e.species_type = tritium
T_e.injection_style = MultipleParticles
T_e.multiple_particles_pos_x = 0
T_e.multiple_particles_pos_y = 0
T_e.multiple_particles_pos_z = 0
T_e.multiple_particles_ux = 0
T_e.multiple_particles_uy = 0
T_e.multiple_particles_uz = u
T_e.multiple_particles_weight = 1
T_e.do_not_push = 1
T_e.do_not_deposit = 1
T_i.species_type = tritium
T_i.injection_style = MultipleParticles
T_i.multiple_particles_pos_x = 0
T_i.multiple_particles_pos_y = 0
T_i.multiple_particles_pos_z = 0
T_i.multiple_particles_ux = 0
T_i.multiple_particles_uy = 0
T_i.multiple_particles_uz = u
T_i.multiple_particles_weight = 1
T_i.do_not_push = 1
T_i.do_not_deposit = 1
T_both.species_type = tritium
T_both.injection_style = MultipleParticles
T_both.multiple_particles_pos_x = 0
T_both.multiple_particles_pos_y = 0
T_both.multiple_particles_pos_z = 0
T_both.multiple_particles_ux = 0
T_both.multiple_particles_uy = 0
T_both.multiple_particles_uz = u
T_both.multiple_particles_weight = 1
T_both.do_not_push = 1
T_both.do_not_deposit = 1
T_control.species_type = tritium
T_control.injection_style = MultipleParticles
T_control.multiple_particles_pos_x = 0
T_control.multiple_particles_pos_y = 0
T_control.multiple_particles_pos_z = 0
T_control.multiple_particles_ux = 0
T_control.multiple_particles_uy = 0
T_control.multiple_particles_uz = u
T_control.multiple_particles_weight = 1
T_control.do_not_push = 1
T_control.do_not_deposit = 1
collisions.collision_names = e1 i1 e2 i2
e1.type = background_stopping
e1.species = T_e
e1.background_type = electrons
e1.background_density = 1.e20
e1.background_temperature = 1.e4*q_e/kb
i1.type = background_stopping
i1.species = T_i
i1.background_type = ions
i1.background_density = 1.e20
i1.background_temperature = 2.e4*q_e/kb
i1.background_mass = md
i1.background_charge_state = 1
e2.type = background_stopping
e2.species = T_both
e2.background_type = electrons
e2.background_density = 1.e20
e2.background_temperature = 1.e4*q_e/kb
i2.type = background_stopping
i2.species = T_both
i2.background_type = ions
i2.background_density = 1.e20
i2.background_temperature = 2.e4*q_e/kb
i2.background_mass = md
i2.background_charge_state = 1
warpx.reduced_diags_names = energy number
energy.type = ParticleEnergy
energy.intervals = 1
energy.precision = 17
number.type = ParticleNumber
number.intervals = 1
number.precision = 17
diagnostics.diags_names = diag1
diag1.diag_type = Full
diag1.intervals = 100
diag1.fields_to_plot = rho
